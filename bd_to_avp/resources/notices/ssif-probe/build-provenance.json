  "unsigned_checksums": {
    "bd_to_avp/bin/ssif_probe": "fbfd5253404d995ce1a7ce2499714b09968af27ad539711caab37191030034b6",
    "bd_to_avp/lib/libbluray.3.dylib": "b9d093eb5b568dfeb6c2c1585985c9064760fbca62b6cf463b7af9dd2baff0df",
    "bd_to_avp/lib/libudfread.3.dylib": "641c92635012dad484fea61bd0f1dddc2cbce2bdd73549a04c15a8b2374bddc8"
  }
